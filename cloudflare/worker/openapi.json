{
  "openapi": "3.1.0",
  "info": {
    "title": "Travel Tools API",
    "version": "1.0.0",
    "description": "Remote travel tool endpoints for Azure AI Foundry."
  },
  "servers": [
    {
      "url": "https://travel-tools-worker.rssebambulidde.workers.dev"
    }
  ],
  "paths": {
    "/weather": {
      "get": {
        "summary": "Get weather for a city",
        "operationId": "get_weather",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "City name to look up."
          }
        ],
        "responses": {
          "200": {
            "description": "Weather response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/itinerary": {
      "get": {
        "summary": "Create a simple itinerary",
        "operationId": "create_itinerary",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Destination city."
          },
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3
            },
            "description": "Number of days."
          }
        ],
        "responses": {
          "200": {
            "description": "Itinerary response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
